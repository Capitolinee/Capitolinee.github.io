---
// 作者工具列：只在開過 /admin/ 的瀏覽器出現。
// edit 是後台裡的路徑，例如 'notes/entries/guild-loot-bot'
import T from './T.astro';
import { ta } from '../lib/i18n';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';

interface Props { edit?: string; }
const { edit } = Astro.props;
const admin = withBase('/admin/');
---

<div class="author-bar" id="author-bar" hidden>
  {
    edit && (
      <a class="ab-btn ab-primary" href={`${admin}#/collections/${edit}`} data-astro-reload>
        <Icon name="note" size={15} /><T k="abEdit" />
      </a>
    )
  }
  <details class="ab-new">
    <summary class="ab-btn"><T k="abNew" /></summary>
    <div class="ab-menu">
      <a href={`${admin}#/collections/notes/new`} data-astro-reload><T k="notes" /></a>
      <a href={`${admin}#/collections/makes/new`} data-astro-reload><T k="makes" /></a>
      <a href={`${admin}#/collections/books/new`} data-astro-reload><T k="books" /></a>
      <a href={`${admin}#/collections/games/new`} data-astro-reload><T k="games" /></a>
    </div>
  </details>
  <a class="ab-btn" href={admin} data-astro-reload><T k="abAdmin" /></a>
  <button type="button" class="ab-btn ab-x" id="author-bar-hide" {...ta('aria-label', 'abHide')} {...ta('title', 'abHide')}>
    <Icon name="x" size={14} />
  </button>
</div>

<script is:inline data-astro-rerun>
  (function () {
    var bar = document.getElementById('author-bar');
    if (!bar) return;
    try {
      if (localStorage.getItem('site-author') === '1') bar.hidden = false;
    } catch (e) {}
    var hide = document.getElementById('author-bar-hide');
    if (hide) hide.addEventListener('click', function () {
      try { localStorage.removeItem('site-author'); } catch (e) {}
      bar.hidden = true;
    });
  })();
</script>
