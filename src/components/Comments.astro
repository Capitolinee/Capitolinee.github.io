---
// 留言：用 Firebase（Google 的服務）存留言，訪客用 Google 帳號登入才能留。
// 在後台「網站設定 → 留言（Firebase）」填好設定才會出現，沒填就什麼都不顯示。
// 設定步驟見 README。
//
// thread：這串留言的名字。不填就用目前網址，例如 /notes/abc/ → notes__abc
import { site } from '../data/site';
import T from './T.astro';
import { ui, ta, type Pair } from '../lib/i18n';

interface Props {
  thread?: string;
  title?: Pair;
}

const fb = site.firebase ?? ({} as Record<string, string | boolean>);
const enabled = Boolean(fb.apiKey && fb.authDomain && fb.projectId && fb.appId);

const base = import.meta.env.BASE_URL;
let path = Astro.url.pathname;
if (base !== '/' && path.startsWith(base)) path = path.slice(base.length - 1);
const autoThread = path.replace(/^\/+|\/+$/g, '').replace(/\//g, '__') || 'home';

const thread = Astro.props.thread ?? autoThread;
const heading = Astro.props.title ?? ui.comments;
const config = JSON.stringify({
  apiKey: fb.apiKey,
  authDomain: fb.authDomain,
  projectId: fb.projectId,
  appId: fb.appId,
});
---

{
  enabled && (
    <section
      class="cmt"
      data-thread={thread}
      data-config={config}
      data-owner={String(fb.ownerEmail ?? '')}
      data-github={fb.github ? '1' : ''}
      {...ta('aria-label', heading)}
    >
      <div class="cmt-head">
        <h2><T {...heading} /></h2>
        <span class="cmt-count mono" />
      </div>
      <div class="cmt-auth" aria-live="polite">
        <p class="cmt-muted"><T k="loading" /></p>
      </div>
      <p class="cmt-error" role="alert" hidden />
      <ol class="cmt-list" />
      <p class="cmt-empty cmt-muted" hidden><T k="noComments" /></p>
    </section>
  )
}

<script>
  type Cfg = { apiKey: string; authDomain: string; projectId: string; appId: string };
  type Item = { id: string; uid: string; name: string; photo?: string; text: string; author: boolean; date: Date };

  // Firebase 只在需要時才下載，而且整個網站只初始化一次
  let fbPromise: Promise<any> | null = null;
  const loadFirebase = (cfg: Cfg) => {
    if (!fbPromise) {
      fbPromise = (async () => {
        const [appMod, A, F] = await Promise.all([
          import('firebase/app'),
          import('firebase/auth'),
          import('firebase/firestore/lite'),
        ]);
        const app = appMod.getApps()[0] ?? appMod.initializeApp(cfg);
        return { auth: A.getAuth(app), db: F.getFirestore(app), A, F };
      })();
    }
    return fbPromise;
  };

  // 介面文字，跟著網站語言
  const isZh = () => document.documentElement.dataset.lang === 'zh';
  const L = () =>
    isZh()
      ? {
          popupBlocked: '登入視窗被瀏覽器擋下來了，請允許這個網站開啟彈出視窗再試一次。',
          badDomain: '這個網域還沒加進 Firebase 的授權網域（見 README）。',
          denied: '送出失敗。可能是留言太長、或登入過期了，請重新登入再試一次。',
          network: '網路好像斷了，等一下再試試。',
          noDb: '找不到留言資料庫。請確認 Firestore 資料庫已經建立，而且資料庫 ID 是 (default)。',
          noGoogle: 'Firebase 還沒開啟 Google 登入',
          generic: '出了點問題，等一下再試試。',
          unknown: '未知錯誤',
          author: '作者',
          del: '刪除',
          confirmDel: '確定要刪除這則留言嗎？',
          count: (n: number) => `${n} 則`,
          signInPrompt: '登入之後就能留言',
          google: '用 Google 登入',
          github: '用 GitHub 登入',
          guest: '訪客',
          signOut: '登出',
          placeholder: '想說什麼？',
          inputLabel: '留言內容',
          send: '送出',
          sending: '送出中…',
        }
      : {
          popupBlocked: 'The sign-in window was blocked. Allow pop-ups for this site and try again.',
          badDomain: 'This domain isn’t in Firebase’s authorized domains yet (see README).',
          denied: 'Couldn’t post. The comment may be too long, or your sign-in expired — sign in again and retry.',
          network: 'Looks like you’re offline. Try again in a moment.',
          noDb: 'Comment database not found. Make sure Firestore is created with the database ID (default).',
          noGoogle: 'Google sign-in isn’t enabled in Firebase',
          generic: 'Something went wrong. Try again in a moment.',
          unknown: 'unknown error',
          author: 'Author',
          del: 'Delete',
          confirmDel: 'Delete this comment?',
          count: (n: number) => `${n} ${n === 1 ? 'comment' : 'comments'}`,
          signInPrompt: 'Sign in to leave a comment',
          google: 'Sign in with Google',
          github: 'Sign in with GitHub',
          guest: 'Guest',
          signOut: 'Sign out',
          placeholder: 'Say something…',
          inputLabel: 'Comment',
          send: 'Post',
          sending: 'Posting…',
        };

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };

  const ymd = (d: Date) =>
    `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

  const avatar = (name: string, photo?: string) => {
    const box = el('span', 'cmt-avatar');
    if (photo) {
      const img = el('img');
      img.src = photo;
      img.alt = '';
      img.referrerPolicy = 'no-referrer';
      img.loading = 'lazy';
      box.append(img);
    } else {
      box.textContent = (name || '?').slice(0, 1);
    }
    return box;
  };

  const errorText = (err: any) => {
    const code = String(err?.code ?? '');
    if (code.includes('popup-closed') || code.includes('cancelled-popup')) return '';
    const t = L();
    if (code.includes('popup-blocked')) return t.popupBlocked;
    if (code.includes('unauthorized-domain')) return t.badDomain;
    if (code.includes('permission-denied')) return t.denied;
    if (code.includes('network')) return t.network;
    if (code.includes('not-found') || code.includes('failed-precondition'))
      return `${t.noDb} (${code})`;
    if (code.includes('operation-not-allowed')) return `${t.noGoogle} (${code})`;
    // 其他沒預料到的錯誤：附上代碼，方便查原因
    return `${t.generic} (${code || err?.message || t.unknown})`;
  };

  function mount(section: HTMLElement) {
    if (section.dataset.mounted) return;
    section.dataset.mounted = '1';

    const cfg: Cfg = JSON.parse(section.dataset.config!);
    const thread = section.dataset.thread!;
    const owner = (section.dataset.owner || '').toLowerCase();
    const withGithub = section.dataset.github === '1';

    const authBox = section.querySelector<HTMLElement>('.cmt-auth')!;
    const list = section.querySelector<HTMLOListElement>('.cmt-list')!;
    const empty = section.querySelector<HTMLElement>('.cmt-empty')!;
    const count = section.querySelector<HTMLElement>('.cmt-count')!;
    const errBox = section.querySelector<HTMLElement>('.cmt-error')!;

    let items: Item[] = [];
    let user: any = null;
    let fb: any = null;

    const showError = (err: any) => {
      // 傳 null 代表「清掉錯誤訊息」
      if (!err) {
        errBox.textContent = '';
        errBox.hidden = true;
        return;
      }
      console.error('[留言]', err);
      const msg = errorText(err);
      errBox.textContent = msg;
      errBox.hidden = !msg;
    };
    const isOwner = (u: any) => Boolean(owner && u?.email && u.emailVerified && u.email.toLowerCase() === owner);
    const canDelete = (it: Item) => Boolean(user && (user.uid === it.uid || isOwner(user)));

    const renderList = () => {
      list.replaceChildren(
        ...items.map((it) => {
          const li = el('li', 'cmt-item');
          const body = el('div', 'cmt-body');
          const meta = el('div', 'cmt-meta');
          meta.append(el('span', 'cmt-name', it.name));
          if (it.author) meta.append(el('span', 'cmt-badge', L().author));
          meta.append(el('time', 'cmt-time mono', ymd(it.date)));
          body.append(meta, el('p', 'cmt-text', it.text));

          if (canDelete(it)) {
            const del = el('button', 'cmt-del', L().del);
            del.type = 'button';
            del.addEventListener('click', async () => {
              if (!confirm(L().confirmDel)) return;
              del.disabled = true;
              try {
                await fb.F.deleteDoc(fb.F.doc(fb.db, 'threads', thread, 'comments', it.id));
                items = items.filter((x) => x.id !== it.id);
                renderList();
              } catch (e) {
                del.disabled = false;
                showError(e);
              }
            });
            body.append(del);
          }

          li.append(avatar(it.name, it.photo), body);
          return li;
        }),
      );
      count.textContent = items.length ? L().count(items.length) : '';
      empty.hidden = items.length > 0;
    };

    const renderAuth = () => {
      authBox.replaceChildren();

      if (!user) {
        const wrap = el('div', 'cmt-login');
        wrap.append(el('p', 'cmt-muted', L().signInPrompt));
        const btns = el('div', 'cmt-login-btns');

        const google = el('button', 'cmt-btn cmt-btn-primary');
        google.type = 'button';
        google.innerHTML =
          '<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.35 11.1H12v2.9h5.35c-.23 1.4-1.64 4.1-5.35 4.1-3.22 0-5.85-2.67-5.85-5.95S8.78 6.2 12 6.2c1.83 0 3.06.78 3.76 1.45l2.56-2.47C16.68 3.65 14.53 2.7 12 2.7 6.87 2.7 2.7 6.87 2.7 12s4.17 9.3 9.3 9.3c5.37 0 8.93-3.77 8.93-9.08 0-.61-.07-1.08-.16-1.52z"/></svg>' + L().google;
        google.addEventListener('click', () => {
          showError(null);
          fb.A.signInWithPopup(fb.auth, new fb.A.GoogleAuthProvider()).catch(showError);
        });
        btns.append(google);

        if (withGithub) {
          const gh = el('button', 'cmt-btn', L().github);
          gh.type = 'button';
          gh.addEventListener('click', () => {
            showError(null);
            fb.A.signInWithPopup(fb.auth, new fb.A.GithubAuthProvider()).catch(showError);
          });
          btns.append(gh);
        }

        wrap.append(btns);
        authBox.append(wrap);
        return;
      }

      const name = (user.displayName || user.email?.split('@')[0] || L().guest).slice(0, 60);
      const form = el('form', 'cmt-form');

      const who = el('div', 'cmt-who');
      who.append(avatar(name, user.photoURL || undefined), el('span', 'cmt-name', name));
      if (isOwner(user)) who.append(el('span', 'cmt-badge', L().author));
      const out = el('button', 'cmt-link', L().signOut);
      out.type = 'button';
      out.addEventListener('click', () => fb.A.signOut(fb.auth));
      who.append(out);

      const ta = el('textarea', 'cmt-input');
      ta.name = 'text';
      ta.rows = 3;
      ta.maxLength = 1000;
      ta.placeholder = L().placeholder;
      ta.setAttribute('aria-label', L().inputLabel);

      const foot = el('div', 'cmt-foot');
      const left = el('span', 'cmt-muted mono', '0 / 1000');
      const send = el('button', 'cmt-btn cmt-btn-primary', L().send);
      send.type = 'submit';
      send.disabled = true;
      foot.append(left, send);

      ta.addEventListener('input', () => {
        left.textContent = `${ta.value.length} / 1000`;
        send.disabled = ta.value.trim().length === 0;
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const text = ta.value.trim();
        if (!text) return;
        send.disabled = true;
        send.textContent = L().sending;
        showError(null);
        try {
          const data: Record<string, unknown> = {
            uid: user.uid,
            name,
            text,
            author: isOwner(user),
            createdAt: fb.F.serverTimestamp(),
          };
          if (user.photoURL) data.photo = user.photoURL;
          const ref = await fb.F.addDoc(fb.F.collection(fb.db, 'threads', thread, 'comments'), data);
          items = [{ id: ref.id, uid: user.uid, name, photo: user.photoURL || undefined, text, author: isOwner(user), date: new Date() }, ...items];
          renderList();
          ta.value = '';
          left.textContent = '0 / 1000';
        } catch (err) {
          showError(err);
        } finally {
          send.textContent = L().send;
          send.disabled = ta.value.trim().length === 0;
        }
      });

      form.append(who, ta, foot);
      authBox.append(form);
    };

    const start = async () => {
      try {
        fb = await loadFirebase(cfg);
        const q = fb.F.query(
          fb.F.collection(fb.db, 'threads', thread, 'comments'),
          fb.F.orderBy('createdAt', 'desc'),
          fb.F.limit(200),
        );
        const snap = await fb.F.getDocs(q);
        items = snap.docs.map((d: any) => {
          const v = d.data();
          return {
            id: d.id,
            uid: v.uid,
            name: v.name,
            photo: v.photo,
            text: v.text,
            author: Boolean(v.author),
            date: v.createdAt?.toDate?.() ?? new Date(),
          };
        });
        renderList();

        const stop = fb.A.onAuthStateChanged(fb.auth, (u: any) => {
          user = u;
          if (u) showError(null); // 登入成功，清掉登入過程中的錯誤
          renderAuth();
          renderList(); // 登入狀態改變時，刪除按鈕要跟著更新
        });
        // 切換語言時重畫，已經打的字要保留
        const onLang = () => {
          const draft = authBox.querySelector<HTMLTextAreaElement>('.cmt-input')?.value ?? '';
          renderAuth();
          renderList();
          const box = authBox.querySelector<HTMLTextAreaElement>('.cmt-input');
          if (box && draft) {
            box.value = draft;
            box.dispatchEvent(new Event('input'));
          }
          if (!errBox.hidden) errBox.hidden = true; // 舊語言的錯誤訊息就不留了
        };
        document.addEventListener('langchange', onLang);

        // 換頁時停止監聽
        document.addEventListener(
          'astro:before-swap',
          () => {
            stop();
            document.removeEventListener('langchange', onLang);
          },
          { once: true },
        );
      } catch (err) {
        authBox.replaceChildren();
        showError(err);
      }
    };

    // 捲到附近才載入 Firebase，不拖慢頁面
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          start();
        }
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(section);
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.cmt').forEach(mount);
  });
</script>
