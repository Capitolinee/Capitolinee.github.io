---
// 照片放大檢視。頁面上任何 .gallery-item 按鈕（裡面放一張 img）點了都會開這個。
// 按鈕可以加 data-caption，放大時會顯示在張數旁邊。
// 左右鍵或手機滑動切換，Esc 或點旁邊關閉。
import { ta } from '../lib/i18n';
import Icon from './Icon.astro';
---

<dialog class="lightbox" {...ta('aria-label', 'lbDialog')}>
  <button type="button" class="lb-btn lb-close" {...ta('aria-label', 'lbClose')}>
    <Icon name="x" size={20} />
  </button>
  <button type="button" class="lb-btn lb-prev" {...ta('aria-label', 'lbPrev')}>
    <Icon name="left" size={22} />
  </button>
  <figure class="lb-stage">
    <img class="lb-img" alt="" />
    <figcaption class="lb-count mono"></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-next" {...ta('aria-label', 'lbNext')}>
    <Icon name="right" size={22} />
  </button>
</dialog>

<script>
  document.addEventListener('astro:page-load', () => {
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
    const items = [...document.querySelectorAll<HTMLButtonElement>('.gallery-item')];
    if (!dialog || items.length === 0 || dialog.dataset.bound) return;
    dialog.dataset.bound = '1';

    const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
    const count = dialog.querySelector<HTMLElement>('.lb-count')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lb-prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lb-next')!;
    const close = dialog.querySelector<HTMLButtonElement>('.lb-close')!;
    const sources = items.map((b) => ({ img: b.querySelector('img')!, caption: b.dataset.caption ?? '' }));
    let current = 0;
    let opener: HTMLElement | null = null;

    const single = sources.length === 1;
    prev.hidden = single;
    next.hidden = single;

    const show = (i: number) => {
      current = (i + sources.length) % sources.length;
      const s = sources[current];
      img.src = s.img.currentSrc || s.img.src;
      img.alt = s.img.alt;
      const n = single ? '' : `${current + 1} / ${sources.length}`;
      count.textContent = [n, s.caption].filter(Boolean).join('  ·  ');
    };

    items.forEach((button, i) => {
      button.addEventListener('click', () => {
        opener = button;
        show(i);
        dialog.showModal();
      });
    });

    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    close.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.classList.contains('lb-stage')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('close', () => opener?.focus());

    let startX = 0;
    dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 48) show(current + (dx < 0 ? 1 : -1));
    });
  });
</script>
