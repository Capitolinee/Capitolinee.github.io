---
import { withBase } from '../lib/url';
import { tagHref } from '../lib/content';

interface Props { tags: string[]; }
const { tags } = Astro.props;
---
{
  tags.length > 0 && (
    <ul class="tags" aria-label="標籤">
      {tags.map((t) => (
        <li><a class="tag" href={withBase(tagHref(t))}>#{t}</a></li>
      ))}
    </ul>
  )
}
