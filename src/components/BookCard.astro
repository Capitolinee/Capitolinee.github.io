---
import T from './T.astro';
import { withBase } from '../lib/url';
import { placeholder, stars, ym } from '../lib/format';
import { ta } from '../lib/i18n';

interface Props {
  title: string;
  author?: string;
  status: 'reading' | 'done' | 'want';
  rating: number;
  date?: Date;
  cover?: string;
  link?: string;
  id: string;
  tags?: string[];
  quotes?: number; // 書摘幾則
}
const { title, author, status, rating, date, cover, link, id, tags = [], quotes = 0 } = Astro.props;
const label = { reading: 'statusReading', want: 'statusWant', done: null }[status] as 'statusReading' | 'statusWant' | null;
---

<div class="book" data-tags={tags.join('|')}>
  {
    cover ? (
      <button type="button" class="cover gallery-item" {...ta('aria-label', { en: `Enlarge cover: ${title}`, zh: `放大書封：${title}` })}>
        <img src={withBase(cover)} alt="" loading="lazy" />
      </button>
    ) : (
      <div class:list={['cover', placeholder(id)]} />
    )
  }
  <div class="t">
    <h3>{link ? <a href={withBase(link)}>{title}</a> : title}</h3>
    <div class="meta">
      {label && <span class:list={['status', `status-${status}`]}><T k={label} /></span>}
      {status === 'done' && rating > 0 && <span class="stars">{stars(rating)}</span>}
      {author && <><span class="sl">//</span><span>{author}</span></>}
      {status === 'done' && date && <><span class="sl">//</span><span>{ym(date)}</span></>}
    </div>
    {
      quotes > 0 && (
        <a class="book-quotes" href={withBase(`/quotes/#q-${id}`)}>
          <T en={`${quotes} ${quotes === 1 ? 'highlight' : 'highlights'}`} zh={`書摘 ${quotes}`} />
        </a>
      )
    }
  </div>
</div>
