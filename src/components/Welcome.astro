---
// 歡迎畫面：訪客點一下，瀏覽器就允許播音樂。
// - 每次新造訪出現一次（站內換頁不會再出現）
// - 選「不要音樂」的訪客，之後不會再看到
// - 沒設定背景音樂就不顯示
// 文字在後台「網站設定 → 歡迎畫面」可以改。
import { site } from '../data/site';

const w = site.welcome ?? {};
const title = w.title || '歡迎光臨';
const subtitle = w.subtitle || '';
---

<div class="welcome" id="welcome" role="dialog" aria-modal="true" aria-labelledby="welcome-title" hidden>
  <div class="welcome-inner">
    <p class="welcome-name">{site.name}</p>
    <div class="welcome-ring" aria-hidden="true">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18V5l11-2v13"></path>
        <circle cx="6" cy="18" r="3"></circle>
        <circle cx="17" cy="16" r="3"></circle>
      </svg>
    </div>
    <h1 class="welcome-title" id="welcome-title">{title}</h1>
    {subtitle && <p class="welcome-sub">{subtitle}</p>}
    <button type="button" class="welcome-enter" id="welcome-enter">點一下進入</button>
    <button type="button" class="welcome-quiet" id="welcome-quiet">不要音樂，直接進去</button>
    <p class="welcome-hint">進站之後，左下角的音符可以隨時暫停</p>
  </div>
</div>

<!-- 同步執行：在畫面出現之前就決定要不要蓋上歡迎畫面，避免內容先閃一下 -->
<script is:inline>
  (function () {
    var el = document.getElementById('welcome');
    if (!el) return;
    var root = document.documentElement;
    try {
      var seen = sessionStorage.getItem('welcomed') === '1';
      var off = localStorage.getItem('music-off') === '1';
      if (seen || off) { el.remove(); return; }
    } catch (e) { el.remove(); return; }

    el.hidden = false;
    root.dataset.welcome = 'open';
    root.style.overflow = 'hidden';

    function done(music) {
      try { sessionStorage.setItem('welcomed', '1'); } catch (e) {}
      delete root.dataset.welcome;
      root.style.overflow = '';
      document.querySelectorAll('body > *').forEach(function (n) { if (n !== el) n.inert = false; });
      el.classList.add('leaving');
      setTimeout(function () { el.remove(); }, 650);
      document.dispatchEvent(new CustomEvent('welcome:done', { detail: { music: music } }));
    }

    document.addEventListener('DOMContentLoaded', function () {
      // 歡迎畫面開著的時候，後面的內容不能被 Tab 到
      document.querySelectorAll('body > *').forEach(function (n) { if (n !== el) n.inert = true; });
      var enter = document.getElementById('welcome-enter');
      var quiet = document.getElementById('welcome-quiet');
      enter.addEventListener('click', function () { done(true); });
      quiet.addEventListener('click', function () { done(false); });
      el.addEventListener('keydown', function (e) { if (e.key === 'Escape') done(false); });
      enter.focus();
    });
  })();
</script>
