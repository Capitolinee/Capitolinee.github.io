---
// 文章目錄：有兩個以上的小標題才出現。
// 寬螢幕固定在右邊、目前讀到哪一段會亮起來；窄螢幕放在文章上方。
import T from './T.astro';
import { ta } from '../lib/i18n';
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[]; }
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 2 && (
    <nav class="toc" {...ta('aria-label', 'toc')} data-pagefind-ignore>
      <p class="toc-title"><T k="toc" /></p>
      <ol>
        {items.map((h) => (
          <li class:list={[`toc-d${h.depth}`]}>
            <a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  // 捲動時標出目前讀到的段落
  document.addEventListener('astro:page-load', () => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]')];
    if (!links.length) return;
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.dataset.toc!)))
      .filter((el): el is HTMLElement => Boolean(el));

    const setActive = (id: string) => {
      links.forEach((a) => a.classList.toggle('on', decodeURIComponent(a.dataset.toc!) === id));
    };

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-90px 0px -65% 0px' },
    );
    targets.forEach((t) => io.observe(t));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>
