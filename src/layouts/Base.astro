---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import { withBase } from '../lib/url';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/Icon.astro';
import AuthorBar from '../components/AuthorBar.astro';
import MusicToggle from '../components/MusicToggle.astro';
import Welcome from '../components/Welcome.astro';
import LangToggle from '../components/LangToggle.astro';
import T from '../components/T.astro';
import { youtubeParts } from '../lib/youtube';
import { pair, ta, contentPair, type Key, type Pair } from '../lib/i18n';

interface Props {
  // 字串 = 中英文一樣（例如文章標題）；{ en, zh } = 跟著語言切換（例如 ui.notes）
  title?: string | Pair;
  description?: string;
  crumb?: Key | Pair;
  edit?: string; // 後台的編輯路徑，給作者工具列用
  og?: string; // 分享預覽圖，例如 '/og/notes/abc.png'
  type?: 'website' | 'article';
}

const { title, description, crumb, edit, og = '/og/default.png', type = 'website' } = Astro.props;

// 標題：字串就兩種語言一樣；{ en, zh } 就各一份
const t: Pair | null = !title ? null : typeof title === 'string' ? { en: title, zh: title } : title;
const titleEn = t ? `${t.en} — ${site.name}` : site.name;
const titleZh = t ? `${t.zh} — ${site.name}` : site.name;
const pageTitle = titleEn; // 預設英文
const pageDescription = description ?? site.lede;
const path = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL('https://example.com');
const canonical = new URL(path, siteUrl).href;
const ogImage = new URL(withBase(og), siteUrl).href;
const isOn = (p: string) => path.startsWith(withBase(p));

// 有設定背景音樂才需要歡迎畫面
const musicUrl = site.music?.url?.trim() ?? '';
const hasMusic = /\.(mp3|m4a|aac|ogg|opus|wav)(\?.*)?$/i.test(musicUrl) || Boolean(youtubeParts(musicUrl));
---

<!doctype html>
<html lang="zh-Hant" data-title-en={titleEn} data-title-zh={titleZh}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <!-- 分享預覽：Discord、LINE、Facebook、X 都讀這幾行 -->
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={t?.en ?? site.name} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <!-- Discord 預覽卡左邊那條線的顏色 -->
    <meta name="theme-color" content="#88c0d0" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={withBase('/rss.xml')} />

    <!-- 在畫面繪製之前套用存下來的主題，避免重新整理時閃一下。
         必須是同步的 inline script，不能讓 Astro 打包延後執行。 -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}

      // 語言：預設英文，選過中文就記住。文字靠 CSS 切，屬性和標題靠下面這個函式換。
      try {
        if (localStorage.getItem('lang') === 'zh') document.documentElement.dataset.lang = 'zh';
      } catch {}
      window.__applyLang = function () {
        var root = document.documentElement;
        var l = root.dataset.lang === 'zh' ? 'zh' : 'en';
        var prefix = 'data-' + l + '-';
        document.querySelectorAll('[data-i18n]').forEach(function (el) {
          var sets = [];
          for (var i = 0; i < el.attributes.length; i++) {
            var a = el.attributes[i];
            if (a.name.indexOf(prefix) === 0) sets.push([a.name.slice(prefix.length), a.value]);
          }
          sets.forEach(function (x) { el.setAttribute(x[0], x[1]); });
        });
        var title = root.getAttribute('data-title-' + l);
        if (title) document.title = title;
      };
      if (document.documentElement.dataset.lang === 'zh') {
        document.title = document.documentElement.getAttribute('data-title-zh') || document.title;
        document.addEventListener('DOMContentLoaded', window.__applyLang);
      }
    </script>

    <!-- 站內換頁不重新載入整頁，背景音樂才能不中斷 -->
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700;900&family=Geist+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700;900&display=swap"
    />
  </head>

  <body>
    {hasMusic && <Welcome />}
    <a class="skip" href="#main"><T k="skip" /></a>

    <div class="topbar">
      <div class="shell">
        <header class="bar">
          <a class="logo" href={withBase('/')}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="1.5" y="1.5" width="21" height="21" rx="6" fill="currentColor" opacity=".14"></rect>
              <path d="M7 17V7l5 6 5-6v10" stroke="currentColor" stroke-width="2.1"
                    stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            {site.name}
          </a>

          <nav {...ta('aria-label', 'mainNav')}>
            <a href={withBase('/notes/')} aria-current={isOn('/notes') ? 'page' : undefined}><T k="notes" /></a>
            <a href={withBase('/makes/')} aria-current={isOn('/makes') ? 'page' : undefined}><T k="makes" /></a>
            <a href={withBase('/books/')} aria-current={isOn('/books') ? 'page' : undefined}><T k="books" /></a>
            <a href={withBase('/about/')} aria-current={isOn('/about') ? 'page' : undefined}><T k="about" /></a>
          </nav>

          <span class="right">
            <a class="icon-btn" href={withBase('/search/')} {...ta('aria-label', 'search')} {...ta('title', 'search')}>
              <Icon name="search" size={16} />
            </a>
            <LangToggle />
            <ThemeToggle />
            <a class="pill-btn" href={site.github}>GitHub</a>
          </span>
        </header>
      </div>
    </div>

    <div class="shell">
      {
        crumb && (
          <span class="crumb">
            <Icon name="home" size={15} />
            <b>{site.name}</b><span class="sl">/</span><T {...pair(crumb)} />
          </span>
        )
      }

      <main id="main">
        <slot />
      </main>

      <footer class="foot">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="dot"></span>
        <a href={`mailto:${site.email}`}>Email</a>
        <span class="dot"></span>
        <a href={site.github}>GitHub</a>
        <span class="dot"></span>
        <a href={withBase('/rss.xml')}>RSS</a>
        <span class="dot"></span>
        <a href={withBase('/tags/')}><T k="tags" /></a>
        <span class="dot"></span>
        <a href={withBase('/photos/')}><T k="photos" /></a>
        <span class="dot"></span>
        <a href={withBase('/review/')}><T k="review" /></a>
        <span class="dot"></span>
        <span><T {...contentPair(site.footerNote, (site as any).footerNoteEn)} /></span>
      </footer>
    </div>

    <MusicToggle />
    <AuthorBar edit={edit} />

    <script>
      // 自訂換頁方式：只換掉其他內容，背景音樂那一塊完全不碰。
      // Astro 內建的 transition:persist 會移動元素，YouTube 播放器（iframe）一移動就會重新載入，
      // 音樂就會從頭播，所以這裡自己處理。
      import { swapFunctions } from 'astro:transitions/client';

      const { deselectScripts, swapRootAttributes, swapHeadElements, swapBodyElement, saveFocus } = swapFunctions;

      const reapplyTheme = () => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
          if (localStorage.getItem('lang') === 'zh') document.documentElement.dataset.lang = 'zh';
        } catch {}
      };

      document.addEventListener('astro:before-swap', (e) => {
        const next = e.newDocument;
        e.swap = () => {
          deselectScripts(next);
          swapRootAttributes(next);
          reapplyTheme(); // 新頁面的 <html> 沒有 data-theme、data-lang，要補回去
          swapHeadElements(next);
          const restoreFocus = saveFocus();

          const keep = document.getElementById('music-root');
          if (!keep) {
            swapBodyElement(next.body, document.body);
            restoreFocus();
            return;
          }

          next.getElementById('music-root')?.remove();
          for (const n of [...document.body.childNodes]) if (n !== keep) n.remove();
          for (const a of [...document.body.attributes]) document.body.removeAttribute(a.name);
          for (const a of [...next.body.attributes]) document.body.setAttribute(a.name, a.value);
          for (const n of [...next.body.childNodes]) document.body.insertBefore(n, keep);

          restoreFocus();
        };
      });

      // 換頁後，新內容的屬性和頁面標題要換成目前的語言
      document.addEventListener('astro:after-swap', () => (window as any).__applyLang?.());
    </script>
  </body>
</html>
