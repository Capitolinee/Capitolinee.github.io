---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { ymd } from '../../lib/format';
import { liveNotes } from '../../lib/content';
import T from '../../components/T.astro';
import { ui, ta } from '../../lib/i18n';

const notes = await liveNotes();
---

<Base title={ui.notes} crumb="notes" edit="notes">
  <div class="page-head">
    <h1><T k="notes" /></h1>
    <p class="lede"><T k="notesLede" /></p>
  </div>

  {
    notes.length > 0 ? (
      <div class="grid list-grid">
        {notes.map((n, i) => (
          <EntryCard
            href={`/notes/${n.id}/`}
            title={n.data.title}
            kind="kindNote"
            date={ymd(n.data.date)}
            cover={n.data.cover}
            id={n.id}
            featured={i === 0}
          />
        ))}
      </div>
    ) : (
      <p class="empty"><T k="emptyNotes" /></p>
    )
  }
</Base>
