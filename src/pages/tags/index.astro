---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';
import { allTags, tagHref } from '../../lib/content';
import T from '../../components/T.astro';
import { ui, ta } from '../../lib/i18n';
import TagText from '../../components/TagText.astro';

const tags = await allTags();
---

<Base title={ui.tags} crumb="tags">
  <div class="page-head">
    <h1><T k="tags" /></h1>
    <p class="lede"><T k="tagsLede" /></p>
  </div>

  {
    tags.length > 0 ? (
      <ul class="tags tags-lg">
        {tags.map((t) => (
          <li>
            <a class="tag" href={withBase(tagHref(t.name))}>
              #<TagText t={t.name} /><span class="n">{t.count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty"><T k="emptyTags" /></p>
    )
  }
</Base>
