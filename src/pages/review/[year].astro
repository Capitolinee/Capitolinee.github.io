---
import Base from '../../layouts/Base.astro';
import YearReview from '../../components/YearReview.astro';
import { contentYears } from '../../lib/years';
import { ui } from '../../lib/i18n';

export async function getStaticPaths() {
  return (await contentYears()).map((y) => ({ params: { year: String(y) } }));
}

const year = Number(Astro.params.year);
---

<Base title={{ en: `${year} in Review`, zh: `${year} 年度回顧` }} crumb="review">
  <YearReview year={year} />
</Base>
