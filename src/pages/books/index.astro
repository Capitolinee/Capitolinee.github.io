---
import Base from '../../layouts/Base.astro';
import BookCard from '../../components/BookCard.astro';
import Lightbox from '../../components/Lightbox.astro';
import { liveBooks } from '../../lib/content';
import { withBase } from '../../lib/url';
import T from '../../components/T.astro';
import { ui, ta } from '../../lib/i18n';

const books = await liveBooks();
const reading = books.filter((b) => b.data.status === 'reading');
const want = books.filter((b) => b.data.status === 'want');
const done = books.filter((b) => b.data.status === 'done');

// 讀完的依年份分組；沒填日期的放「更早」
const byYear = new Map<string, typeof done>();
for (const b of done) {
  const key = b.data.date ? String(b.data.date.getFullYear()) : 'earlier';
  if (!byYear.has(key)) byYear.set(key, []);
  byYear.get(key)!.push(b);
}
const groups = [...byYear.entries()].sort(([a], [b]) =>
  a === 'earlier' ? 1 : b === 'earlier' ? -1 : Number(b) - Number(a),
);

// 書用到的所有標籤，多的在前（給上方篩選用）
const tagCount = new Map<string, number>();
for (const b of books) for (const t of b.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const bookTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hant')).map(([t]) => t);
const hasQuotes = books.some((b) => b.data.quotes.length > 0);

const shelves = [
  ...(reading.length ? [{ title: ui.shelfReading, items: reading }] : []),
  ...groups.map(([title, items]) => ({ title: title === 'earlier' ? ui.shelfEarlier : { en: title, zh: title }, items })),
  ...(want.length ? [{ title: ui.shelfWant, items: want }] : []),
];
---

<Base title={ui.books} crumb="books" edit="books">
  <div data-pagefind-body>
    <div class="page-head">
      <h1><T k="books" /></h1>
      <p class="lede">
        <T en={`Reading ${reading.length} · Finished ${done.length} · Want to read ${want.length}. Ratings are just how I felt at the time.`} zh={`在讀 ${reading.length} 本，讀完 ${done.length} 本，想讀 ${want.length} 本。星等純粹是當下的感覺。`} />
      </p>
      <p class="lede book-links" style="margin-top: 10px">
        <a class="inline-link" href={withBase('/review/')}><T k="seeReview" /></a>
        {hasQuotes && <a class="inline-link" href={withBase('/quotes/')}><T k="seeQuotes" /></a>}
      </p>

      {
        bookTags.length > 0 && (
          <div class="filters" role="group" {...ta('aria-label', 'tagFilter')} data-pagefind-ignore>
            <button type="button" class="filter on" data-filter="" aria-pressed="true"><T k="allBooks" /></button>
            {bookTags.map((t) => (
              <button type="button" class="filter" data-filter={t} aria-pressed="false">#{t}</button>
            ))}
          </div>
        )
      }
    </div>

    {
      shelves.length > 0 ? (
        shelves.map((shelf) => (
          <section class="sec shelf">
            <div class="sec-top"><h2><T {...shelf.title} /></h2></div>
            <div class="grid">
              {shelf.items.map((b) => (
                <BookCard
                  title={b.data.title}
                  author={b.data.author}
                  status={b.data.status}
                  rating={b.data.rating}
                  date={b.data.date}
                  cover={b.data.cover}
                  link={b.data.link}
                  id={b.id}
              tags={b.data.tags}
              quotes={b.data.quotes.length}
                />
              ))}
            </div>
          </section>
        ))
      ) : (
        <p class="empty"><T k="emptyBooks" /></p>
      )
    }
  </div>
  <Lightbox />
</Base>

<script>
  // 依標籤篩選：一本書可以有好幾個標籤，只要有其中一個就顯示；整個書架都沒書就藏起來
  document.addEventListener('astro:page-load', () => {
    const btns = [...document.querySelectorAll<HTMLButtonElement>('.filters .filter')];
    if (!btns.length || btns[0].dataset.bound) return;
    btns[0].dataset.bound = '1';
    const shelves = [...document.querySelectorAll<HTMLElement>('.shelf')];
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter ?? '';
        btns.forEach((x) => {
          const on = x === b;
          x.classList.toggle('on', on);
          x.setAttribute('aria-pressed', String(on));
        });
        shelves.forEach((shelf) => {
          let shown = 0;
          shelf.querySelectorAll<HTMLElement>('.book').forEach((card) => {
            const ok = !f || (card.dataset.tags ?? '').split('|').includes(f);
            card.hidden = !ok;
            if (ok) shown += 1;
          });
          shelf.hidden = shown === 0;
        });
      }),
    );
  });
</script>
