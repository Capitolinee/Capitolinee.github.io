---
import Base from '../../layouts/Base.astro';
import BookCard from '../../components/BookCard.astro';
import { liveBooks } from '../../lib/content';
import { withBase } from '../../lib/url';
import T from '../../components/T.astro';
import { ui, ta } from '../../lib/i18n';

const books = await liveBooks();
const reading = books.filter((b) => b.data.status === 'reading');
const want = books.filter((b) => b.data.status === 'want');
const done = books.filter((b) => b.data.status === 'done');

// 讀完的依年份分組；沒填日期的放「更早」
const byYear = new Map<string, typeof done>();
for (const b of done) {
  const key = b.data.date ? String(b.data.date.getFullYear()) : 'earlier';
  if (!byYear.has(key)) byYear.set(key, []);
  byYear.get(key)!.push(b);
}
const groups = [...byYear.entries()].sort(([a], [b]) =>
  a === 'earlier' ? 1 : b === 'earlier' ? -1 : Number(b) - Number(a),
);

const shelves = [
  ...(reading.length ? [{ title: ui.shelfReading, items: reading }] : []),
  ...groups.map(([title, items]) => ({ title: title === 'earlier' ? ui.shelfEarlier : { en: title, zh: title }, items })),
  ...(want.length ? [{ title: ui.shelfWant, items: want }] : []),
];
---

<Base title={ui.books} crumb="books" edit="books">
  <div data-pagefind-body>
    <div class="page-head">
      <h1><T k="books" /></h1>
      <p class="lede">
        <T en={`Reading ${reading.length} · Finished ${done.length} · Want to read ${want.length}. Ratings are just how I felt at the time.`} zh={`在讀 ${reading.length} 本，讀完 ${done.length} 本，想讀 ${want.length} 本。星等純粹是當下的感覺。`} />
      </p>
      <p class="lede" style="margin-top: 10px"><a class="inline-link" href={withBase('/review/')}><T k="seeReview" /></a></p>
    </div>

    {
      shelves.length > 0 ? (
        shelves.map((shelf) => (
          <section class="sec">
            <div class="sec-top"><h2><T {...shelf.title} /></h2></div>
            <div class="grid">
              {shelf.items.map((b) => (
                <BookCard
                  title={b.data.title}
                  author={b.data.author}
                  status={b.data.status}
                  rating={b.data.rating}
                  date={b.data.date}
                  cover={b.data.cover}
                  link={b.data.link}
                  id={b.id}
                />
              ))}
            </div>
          </section>
        ))
      ) : (
        <p class="empty"><T k="emptyBooks" /></p>
      )
    }
  </div>
</Base>
