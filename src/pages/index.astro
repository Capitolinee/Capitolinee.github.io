---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import EntryCard from '../components/EntryCard.astro';
import MakeCard from '../components/MakeCard.astro';
import BookCard from '../components/BookCard.astro';
import Lightbox from '../components/Lightbox.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import T from '../components/T.astro';
import { ta, contentPair } from '../lib/i18n';
import { withBase } from '../lib/url';
import { ymd } from '../lib/format';
import { liveNotes, liveMakes, liveBooks, liveGames } from '../lib/content';

const notes = await liveNotes();
const makes = await liveMakes();
const books = await liveBooks();
const games = await liveGames();

// 「最近」把筆記、手作、讀完的書混在一起，取最新四筆
const recent = [
  ...notes.map((n) => ({ id: n.id, title: n.data.title, date: n.data.date, cover: n.data.cover, kind: 'kindNote' as const, href: `/notes/${n.id}/` })),
  ...makes.map((m) => ({ id: m.id, title: m.data.title, date: m.data.date, cover: m.data.cover, kind: 'kindMake' as const, href: `/makes/${m.id}/` })),
  ...games
    .filter((g) => g.data.date)
    .map((g) => ({ id: g.id, title: g.data.title, date: g.data.date!, cover: g.data.cover, kind: 'kindGame' as const, href: `/games/${g.id}/` })),
  ...books
    .filter((b) => b.data.status === 'done' && b.data.date)
    .map((b) => ({ id: b.id, title: b.data.title, date: b.data.date!, cover: b.data.cover, kind: 'kindFinished' as const, href: b.data.link ?? '/books/' })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 4);

// 書：正在讀的排前面，再來是最近讀完的
const shelf = [
  ...books.filter((b) => b.data.status === 'reading'),
  ...books.filter((b) => b.data.status === 'done'),
].slice(0, 4);
---

<Base crumb="home" edit="settings/entries/site">
  <section class="hero">
    <nav class="side" {...ta('aria-label', 'categories')}>
      <a href={withBase('/notes/')}><Icon name="note" /><T k="notes" /></a>
      <a href={withBase('/makes/')}><Icon name="make" /><T k="makes" /></a>
      <a href={withBase('/books/')}><Icon name="book" /><T k="books" /></a>
      <a href={withBase('/games/')}><Icon name="game" /><T k="games" /></a>
      <a href={withBase('/photos/')}><Icon name="photo" /><T k="photos" /></a>
      <a href={withBase('/tags/')}><Icon name="tag" /><T k="tags" /></a>
      <a href={withBase('/about/')}><Icon name="user" /><T k="about" /></a>
    </nav>

    <div>
      <h1><T {...contentPair(site.title, (site as any).titleEn)} /></h1>
      <p class="lede"><T {...contentPair(site.lede, (site as any).ledeEn)} /></p>
    </div>
  </section>

  <section class="sec">
    <SectionHead title="latest" href="/notes/" />
    {
      recent.length > 0 ? (
        <div class="grid">
          {recent.map((item, i) => (
            <EntryCard
              href={item.href}
              title={item.title}
              kind={item.kind}
              date={ymd(item.date)}
              cover={item.cover}
              id={item.id}
              featured={i === 0}
            />
          ))}
        </div>
      ) : (
        <p class="empty"><T k="emptyRecent" /></p>
      )
    }
  </section>

  <section class="sec">
    <SectionHead title="makes" href="/makes/" />
    {
      makes.length > 0 ? (
        <div class="grid">
          {makes.slice(0, 4).map((m) => (
            <MakeCard
              href={`/makes/${m.id}/`}
              title={m.data.title}
              material={m.data.material}
              date={m.data.date}
              cover={m.data.cover}
              id={m.id}
            />
          ))}
        </div>
      ) : (
        <p class="empty"><T k="emptyMakes" /></p>
      )
    }
  </section>

  {
    games.length > 0 && (
      <section class="sec">
        <SectionHead title="games" href="/games/" />
        <div class="grid">
          {games.slice(0, 4).map((g) => (
            <EntryCard href={`/games/${g.id}/`} title={g.data.title}
              kind={g.data.game ? { en: g.data.game, zh: g.data.game } : 'kindGame'}
              date={g.data.date ? ymd(g.data.date) : undefined} cover={g.data.cover} id={g.id} />
          ))}
        </div>
      </section>
    )
  }

  <section class="sec">
    <SectionHead title="books" href="/books/" />
    {
      shelf.length > 0 ? (
        <div class="grid">
          {shelf.map((b) => (
            <BookCard
              title={b.data.title}
              author={b.data.author}
              status={b.data.status}
              rating={b.data.rating}
              date={b.data.date}
              cover={b.data.cover}
              link={b.data.link}
              id={b.id}
            />
          ))}
        </div>
      ) : (
        <p class="empty"><T k="emptyBooks" /></p>
      )
    }
  </section>
  <Lightbox />
</Base>
