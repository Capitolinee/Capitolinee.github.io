---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import T from '../components/T.astro';
import { ui, ta } from '../lib/i18n';

const about = await getEntry('pages', 'about');
const rendered = about ? await render(about) : null;
const Content = rendered?.Content;
---

<Base title={about?.data.title ?? ui.about} description={about?.data.summary} crumb="about" edit="pages/entries/about">
  <article data-pagefind-body>
    <div class="page-head">
      <h1>{about?.data.title ?? <T k="about" />}</h1>
      {about?.data.summary && <p class="lede">{about.data.summary}</p>}
    </div>

    <div class="article">
      {Content ? <Content /> : <p><T k="aboutEmpty" /></p>}
    </div>

    <div class="contact">
      <a class="pill-btn" href={`mailto:${site.email}`}><T k="mailMe" /></a>
      <a class="pill-btn" href={site.github}>GitHub</a>
    </div>
  </article>
</Base>
