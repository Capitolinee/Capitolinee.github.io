---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
import T from '../components/T.astro';
import { ui, ta } from '../lib/i18n';
---

<Base title={ui.nfTitle}>
  <section class="nf">
    <p class="nf-code mono">404</p>
    <h1><T k="nfHead" /></h1>
    <p class="nf-lede"><T k="nfLede" /></p>
    <div class="nf-actions">
      <a class="nf-btn nf-primary" href={withBase('/')}><Icon name="home" size={16} /><T k="nfHome" /></a>
      <a class="nf-btn" href={withBase('/search/')}><Icon name="search" size={16} /><T k="nfSearch" /></a>
    </div>
  </section>
</Base>
