---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import TagList from '../../components/TagList.astro';
import Comments from '../../components/Comments.astro';
import PrevNext from '../../components/PrevNext.astro';
import Lightbox from '../../components/Lightbox.astro';
import { withBase } from '../../lib/url';
import { ym } from '../../lib/format';
import { liveMakes } from '../../lib/content';
import T from '../../components/T.astro';
import { ui, ta } from '../../lib/i18n';

export async function getStaticPaths() {
  const makes = await liveMakes(); // 新的在前
  return makes.map((make, i) => {
    const link = (m?: typeof make) => m && { href: `/makes/${m.id}/`, title: m.data.title, date: ym(m.data.date) };
    return {
      params: { slug: make.id },
      props: { make, prev: link(makes[i + 1]), next: link(makes[i - 1]) },
    };
  });
}

const { make, prev, next } = Astro.props;
const { Content } = await render(make);
const photos = make.data.cover ? [make.data.cover, ...make.data.photos] : make.data.photos;
---

<Base title={make.data.title} description={make.data.summary} crumb="makes" edit={`makes/entries/${make.id}`} og={`/og/makes/${make.id}.png`} type="article">
  <article data-pagefind-body>
    <div class="page-head">
      <h1>{make.data.title}</h1>
      <div class="meta">
        {make.data.material && <><span>{make.data.material}</span><span class="sl">//</span></>}
        <span>{ym(make.data.date)}</span>
      </div>
      {make.data.summary && <p class="lede">{make.data.summary}</p>}
      <TagList tags={make.data.tags} />
    </div>

    {
      photos.length > 0 && (
        <div class="gallery">
          {photos.map((src, i) => (
            <button type="button" class="gallery-item" data-index={i} {...ta('aria-label', { en: `Enlarge photo ${i + 1}`, zh: `放大第 ${i + 1} 張照片` })}>
              <img src={withBase(src)} alt={`${make.data.title} (${i + 1})`} loading="lazy" />
            </button>
          ))}
        </div>
      )
    }

    <div class="article">
      <Content />
    </div>
  </article>

  {photos.length > 0 && <Lightbox />}

  <PrevNext prev={prev} next={next} />

  <Comments />

  <a class="back" href={withBase('/makes/')}>
    <Icon name="left" size={14} /><T k="backMakes" />
  </a>
</Base>

