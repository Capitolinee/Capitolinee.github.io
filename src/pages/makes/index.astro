---
import Base from '../../layouts/Base.astro';
import MakeCard from '../../components/MakeCard.astro';
import { liveMakes } from '../../lib/content';
import T from '../../components/T.astro';
import { ui, ta } from '../../lib/i18n';

const makes = await liveMakes();
---

<Base title={ui.makes} crumb="makes" edit="makes">
  <div class="page-head">
    <h1><T k="makes" /></h1>
    <p class="lede"><T k="makesLede" /></p>
  </div>

  {
    makes.length > 0 ? (
      <div class="grid list-grid">
        {makes.map((m) => (
          <MakeCard
            href={`/makes/${m.id}/`}
            title={m.data.title}
            material={m.data.material}
            date={m.data.date}
            cover={m.data.cover}
            id={m.id}
          />
        ))}
      </div>
    ) : (
      <p class="empty"><T k="emptyMakes" /></p>
    )
  }
</Base>
