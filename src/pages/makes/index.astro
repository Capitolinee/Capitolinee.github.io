---
import Base from '../../layouts/Base.astro';
import MakeCard from '../../components/MakeCard.astro';
import { liveMakes } from '../../lib/content';

const makes = await liveMakes();
---

<Base title="手作" crumb="手作" edit="makes">
  <div class="page-head">
    <h1>手作</h1>
    <p class="lede">用手做出來的東西，做壞的也放。</p>
  </div>

  {
    makes.length > 0 ? (
      <div class="grid list-grid">
        {makes.map((m) => (
          <MakeCard
            href={`/makes/${m.id}/`}
            title={m.data.title}
            material={m.data.material}
            date={m.data.date}
            cover={m.data.cover}
            id={m.id}
          />
        ))}
      </div>
    ) : (
      <p class="empty">還沒有手作。</p>
    )
  }
</Base>
